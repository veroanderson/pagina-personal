# Copiar a .env y completar antes de ejecutar la aplicación. Nunca commitear el .env real.

# Proyecto Supabase de producción. La secret key nunca se expone al
# navegador ni se commitea.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Hash scrypt de la contraseña del panel /admin.
# Generar con: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=

# Secreto usado para firmar las cookies de sesión y anonimizar las claves del
# rate limiter. Mínimo 32 caracteres. Generar con: openssl rand -hex 32
SESSION_SECRET=
